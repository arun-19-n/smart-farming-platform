{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "npm ci && npm run build",
    "dockerfile": "Dockerfile.frontend"
  },
  "deploy": {
    "startCommand": "serve -s dist -l 3000",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowSeconds": 600
  },
  "env": {
    "VITE_API_URL": ""
  }
}
